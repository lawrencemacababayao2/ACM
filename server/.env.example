# ---- Server ----
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string

# ---- DB (project-local MariaDB on 3307; see scripts/start-db.ps1) ----
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=acm

# ---- Seed Super Admin mobile (optional). Run once after fresh install: ----
# npm run set-admin-mobile
# ADMIN_MOBILE=09171234567

# ---- SMS gateway (iProg). Leave SMS_API_KEY blank for LOG mode ----
SMS_API_KEY=
SMS_GATEWAY_URL=https://sms.iprogtech.com/api/v1/sms_messages
SMS_PROVIDER=2

# ---- Chatbot LLM (via OpenRouter). Leave LLM_API_KEY blank to use FAQ/DB fallback ----
# Any OpenAI-compatible /chat/completions endpoint (OpenRouter, OpenAI, Groq...)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# ---- Rate limiting / abuse protection (all optional; sane defaults) ----
# Trust of a real reverse proxy. Leave unset/false while direct; set 'loopback'
# (or a hop count / CIDR) only once nginx or Cloudflare sits in front.
TRUST_PROXY=false

# Public anonymous reads (landing site content, FAQs, carousel, programs/events).
RL_PUBLIC_MAX=120            # requests per minute per IP
RL_PUBLIC_CACHE_MS=60000     # shared response cache (ms)

# Signed-in callers (mobile app + admin portal), keyed by user id.
RL_AUTH_MAX=300              # requests per minute per user

# Chatbot (ACM Assistant).
RL_CHATBOT_ANON_PER_MIN=10   # anonymous: per minute per visitor
RL_CHATBOT_ANON_PER_DAY=60   # anonymous: per day per visitor
RL_CHATBOT_USER_PER_MIN=40   # signed-in: per minute per user
CHATBOT_DAILY_CAP=1000       # hard cap on AI calls per day, ALL callers
RL_CHATBOT_CAPTCHA_AFTER=5   # messages before an (optional) CAPTCHA appears
RL_CHATBOT_CAPTCHA_WINDOW_MS=600000
RL_CHATBOT_MAX_CHARS=500     # longest question allowed

# One-time-password sends (registration + forgot-password + mobile change).
RL_OTP_PHONE_PER_MIN=1
RL_OTP_PHONE_PER_HOUR=5
RL_OTP_IP_PER_HOUR=10
OTP_DAILY_SMS_CAP=300        # platform-wide SMS ceiling per calendar day
SMS_MIN_CREDITS=100          # provider balance floor (see sms.js load_balance); 0 disables
# Forgot-password code requests, hourly.
RL_FORGOT_IP_PER_HOUR=5
RL_FORGOT_PER_NUMBER_PER_HOUR=5

# Login throttling (failures only).
RL_LOGIN_MAX=5               # failed attempts / 15 min per mobile+IP
RL_LOGIN_WINDOW_MS=900000
RL_LOGIN_DELAY_STEP_MS=800   # progressive delay per prior failure
RL_LOGIN_DELAY_MAX_MS=8000

# Contact/feedback (no endpoint yet; reserved).
RL_CONTACT_MAX=5             # per hour per IP

# Anonymous visitor cookie (chaos for shared NAT IPs; carries no personal data).
ANON_COOKIE_NAME=acm_anon
ANON_COOKIE_MAX_AGE=2592000  # 30 days
ANON_COOKIE_SAMESITE=Lax
ANON_COOKIE_SECURE=false     # set true once served over HTTPS
ANON_COOKIE_DOMAIN=

# Cloudflare Turnstile (optional CAPTCHA). OFF until TURNSTILE_SECRET is set.
TURNSTILE_ENABLED=
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# OTP endpoints are reached from the mobile app (no widget) so the challenge there
# is OFF unless this is explicitly turned on for a future browser flow.
TURNSTILE_ENFORCE_OTP=false

# LLM call bounds (protects the provider bill and connection slots).
LLM_TIMEOUT_MS=15000
LLM_MAX_OUTPUT_TOKENS=400
LLM_MAX_OUTPUT_CHARS=4000